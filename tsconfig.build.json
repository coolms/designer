{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "emitDeclarationOnly": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": false,
        "removeComments": true,
        "rootDir": "src"
    },
    "include": ["src/**/*.ts"],
    "exclude": ["dist", "node_modules", "coverage", "tests", "**/*.test.ts", "**/*.spec.ts"]
}
